# Both values are required for AI. Choose a model available to your account.
GEMINI_API_KEY=""
GEMINI_MODEL=""

# Required in production; protects AI requests and source creation.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Enter this token in the app's Owner access panel. Never commit it or use a VITE_ prefix.
OWNER_ACCESS_TOKEN=""
PORT=3000
# Use 0.0.0.0 only when your hosting platform requires external binding.
HOST="127.0.0.1"
# Global AI generation requests per 24-hour window, per server process.
AI_DAILY_REQUEST_LIMIT=100
# Extra approved feed hostnames, comma separated (no URLs or wildcards).
# Default source hosts are already approved. Redirect hosts need approval too.
FEED_ALLOWED_HOSTS=""
